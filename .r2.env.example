# Cloudflare R2 settings for add-video-r2.sh
# Copy this file to  .r2.env  and fill in your real values.
# .r2.env is gitignored — your keys never get committed or pushed.

# Your Cloudflare Account ID (32 hex chars, shown on the R2 overview page)
R2_ACCOUNT_ID=your_account_id

# From R2 → "Manage R2 API Tokens" → create a token with Object Read & Write
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# The bucket you created (e.g. watch)
R2_BUCKET=watch

# The bucket's Public Development URL (Bucket → Settings → Public access)
# Looks like: https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev
